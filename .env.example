# Copy this file to .env and fill in values
# On Render, set these in the Environment tab

# REQUIRED: Strong random string for signing JWTs
JWT_SECRET=change_me_to_a_long_random_secret

# REQUIRED: Your Google Gemini API key
GEMINI_API_KEY=

# Set automatically by Render
NODE_ENV=production

# Optional: path to SQLite database file (default: database.db)
# DB_PATH=database.db
