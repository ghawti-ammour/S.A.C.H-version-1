# Copy this file to .env and fill in values
# For Railway deployment, set these in the Environment tab

# ========== MySQL Database Configuration ==========
# REQUIRED: MySQL host address
MYSQLHOST=localhost

# REQUIRED: MySQL port (default: 3306)
MYSQLPORT=3306

# REQUIRED: MySQL username
MYSQLUSER=root

# REQUIRED: MySQL password
MYSQLPASSWORD=your_password_here

# REQUIRED: MySQL database name
MYSQLDATABASE=sach_db

# ========== JWT Configuration ==========
# REQUIRED: Strong random string for signing JWTs
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret

# ========== Server Configuration ==========
# Server port (automatically set by Railway if not specified)
PORT=3000

# Node environment
NODE_ENV=production
